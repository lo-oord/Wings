rules_version = '2';

// Wings — deny-by-default rules.
//
// Ownership always comes from request.auth.uid, never from a client field.
// Private profile data lives in owner-only documents; only the privacy-filtered
// `profiles/{uid}` mirror is readable by other users.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Administrative allowlist. Only the console/service account can write it.
    function adminUids() {
      return get(/databases/$(database)/documents/config/admins).data.uids;
    }

    function staffConfig() {
      return get(/databases/$(database)/documents/config/admins).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in adminUids();
    }

    // Highest role. The owner is listed in `owners` inside the same trusted
    // document, which only the console (or a trusted server) can write. An
    // older project that has no `owners` list treats its admins as owners so
    // the bootstrap cannot lock the real owner out.
    function isOwner() {
      return isAdmin()
        && (
          request.auth.uid in staffConfig().get('owners', [])
          || (!('owners' in staffConfig()) && request.auth.uid in adminUids())
        );
    }

    // ------------------------------------------------ account administration
    // The state lives on `users/{uid}` (a single document), never in a field a
    // client can write: the self-update rule below refuses to touch it.
    function accountExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function accountData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function accountState(uid) {
      return accountExists(uid)
        ? accountData(uid).get('accountStatus', 'active')
        : 'active';
    }

    // A suspension is evaluated against `request.time`, so it expires without
    // a scheduled job and cannot stay active because a client stayed offline.
    function suspensionLive(uid) {
      return accountState(uid) == 'suspended'
        && (
          !('statusExpiresAt' in accountData(uid))
          || accountData(uid).statusExpiresAt == null
          || accountData(uid).statusExpiresAt > request.time
        );
    }

    function accountBlocked(uid) {
      return accountState(uid) == 'banned'
        || accountState(uid) == 'deleted'
        || suspensionLive(uid);
    }

    // A single restriction is disabled for as long as its expiry allows.
    function restrictionOff(uid, key) {
      return accountExists(uid)
        && ('restrictions' in accountData(uid))
        && accountData(uid).restrictions.get(key, false) == true
        && (
          !('restrictionsExpireAt' in accountData(uid))
          || accountData(uid).restrictionsExpireAt == null
          || accountData(uid).restrictionsExpireAt > request.time
        );
    }

    // The signed-in author may perform [key] when the account is not blocked
    // and that feature is not restricted.
    function canAct(uid, key) {
      return signedIn()
        && request.auth.uid == uid
        && !accountBlocked(uid)
        && !restrictionOff(uid, key);
    }

    function validRestrictions(value) {
      return value is map
        && value.keys().hasOnly(['comment', 'post', 'interact', 'community', 'report'])
        && value.get('comment', false) is bool
        && value.get('post', false) is bool
        && value.get('interact', false) is bool
        && value.get('community', false) is bool
        && value.get('report', false) is bool;
    }

    function validAccountState(value) {
      return value in [
        'active', 'warned', 'restricted', 'suspended', 'banned',
        'underReview', 'deleted'
      ];
    }

    // Administrative fields that the account owner may never write.
    function adminFields() {
      return [
        'accountStatus', 'statusReason', 'statusUpdatedAt', 'statusExpiresAt',
        'statusActorUid', 'restrictions', 'restrictionsExpireAt',
        'warningsCount', 'emailHash'
      ];
    }

    // Official marks live in `badges/{uid}` and only an administrator writes
    // them. Clients read the document so a verified or developer handle is
    // drawn the same way on every device, and the owner's profile documents
    // are allowed to copy the value instead of being rejected.
    function badgeData(uid) {
      return get(/databases/$(database)/documents/badges/$(uid)).data;
    }

    // A grant made before `badges/{uid}` existed lives on the public mirror;
    // it still counts, so an already verified account keeps its free renames.
    function hasLegacyBadge(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && ('badges' in get(/databases/$(database)/documents/profiles/$(uid)).data)
        && (
          get(/databases/$(database)/documents/profiles/$(uid)).data.badges.get('verified', false) == true
          || get(/databases/$(database)/documents/profiles/$(uid)).data.badges.get('developer', false) == true
        );
    }

    function hasOfficialBadge(uid) {
      return (
          exists(/databases/$(database)/documents/badges/$(uid))
          && (
            badgeData(uid).get('verified', false) == true
            || badgeData(uid).get('developer', false) == true
          )
        )
        || hasLegacyBadge(uid);
    }

    // True when the badges being written are exactly the administrator's.
    function badgeOverrideMatches(uid, value) {
      return exists(/databases/$(database)/documents/badges/$(uid))
        && value.verified == badgeData(uid).get('verified', false)
        && value.developer == badgeData(uid).get('developer', false);
    }

    // An owner may always clear a mark, never grant one. Without this, a
    // revocation made in the console left `true` stuck on the profile
    // documents: the client copied the cleared value, the write was denied,
    // and the stale copy kept the badge on.
    function badgesCleared(value) {
      return value.verified == false && value.developer == false;
    }

    function validUsername(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 20
        && value.matches('^[A-Za-z0-9_]+$');
    }

    function validDisplayName(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    function validBadges(value) {
      return value is map
        && value.keys().hasOnly(['verified', 'developer'])
        && value.verified is bool
        && value.developer is bool;
    }

    function validPrivacy(value) {
      return value is map
        && value.keys().hasOnly([
          'showProfile', 'bio', 'country', 'age', 'favorites', 'stats'
        ])
        && value.showProfile is bool
        && value.bio is bool
        && value.country is bool
        && value.age is bool
        && value.favorites is bool
        && value.stats is bool;
    }

    // `updatedAt` is the only extra key allowed next to the counters, because
    // profile creation writes it into `users/{uid}/meta/stats`.
    function validStats(value) {
      return value is map
        && value.keys().hasOnly([
          'animeWatched', 'episodesWatched', 'favorites', 'completed', 'updatedAt'
        ])
        && value.animeWatched is int && value.animeWatched >= 0
        && value.episodesWatched is int && value.episodesWatched >= 0
        && value.favorites is int && value.favorites >= 0
        && value.completed is int && value.completed >= 0
        && (!('updatedAt' in value) || value.updatedAt is timestamp);
    }

    // Public favourites: a short, display-only snapshot of the owner's list.
    // Rules cannot iterate a list, so the shape is bounded by size only; the
    // values are written by the owner and never trusted as counters.
    function validFavorites(value) {
      return value is list && value.size() <= 12;
    }

    // Shared validation for the public mirror document.
    function validPublic(value) {
      return value.username is string
        && validUsername(value.username)
        && validDisplayName(value.displayName)
        && validBadges(value.badges)
        && (!('bio' in value) || (value.bio is string && value.bio.size() <= 300))
        && (!('country' in value) || (value.country is string && value.country.size() <= 2))
        && (!('ageGroup' in value) || (value.ageGroup is string && value.ageGroup.size() <= 12))
        && (!('stats' in value) || validStats(value.stats))
        && (!('favorites' in value) || validFavorites(value.favorites))
        && (!('coverVersion' in value)
            || (value.coverVersion is int && value.coverVersion >= 0))
        && (!('private' in value) || value.private is bool);
    }

    function validLibraryEntry(value) {
      return value.updatedAt is timestamp
        && value.isFavorite is bool
        && value.status in ['watching', 'completed', 'planToWatch', 'onHold', 'dropped'];
    }

    function validHistoryEntry(value) {
      return value.updatedAt is timestamp
        && value.positionMs is int && value.positionMs >= 0
        && value.durationMs is int && value.durationMs >= 0
        && value.completed is bool;
    }

    // ------------------------------------------------------------- users
    // Staff may read any account document (that is what the administrative
    // profile page needs, including for a private profile), while ordinary
    // users only ever read their own.
    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.emailHash is string
        && request.resource.data.emailHash.size() == 64
        && !exists(/databases/$(database)/documents/emailBlocks/$(request.resource.data.emailHash))
        && request.resource.data.username is string
        && validUsername(request.resource.data.username)
        && request.resource.data.normalizedUsername == request.resource.data.username.lower()
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 2
        && request.resource.data.ageGroup is string
        && request.resource.data.ageGroup.size() <= 12
        && validPrivacy(request.resource.data.privacy)
        && validStats(request.resource.data.stats)
        && validBadges(request.resource.data.badges)
        && request.resource.data.badges.verified == false
        && request.resource.data.badges.developer == false
        && (!('photoVersion' in request.resource.data)
            || (request.resource.data.photoVersion is int
                && request.resource.data.photoVersion >= 0))
        && (!('coverVersion' in request.resource.data)
            || (request.resource.data.coverVersion is int
                && request.resource.data.coverVersion >= 0))
        && (!('pendingDeletion' in request.resource.data)
            || request.resource.data.pendingDeletion is bool);

      // Owners may edit their own profile but never grant themselves badges.
      // They may only copy the badges an administrator already published on
      // the public mirror, which is what lets a verified account update its
      // bio without the write being rejected. A rename is only accepted when
      // the matching reservation belongs to them.
      allow update: if isSelf(uid)
        && !accountBlocked(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminFields())
        && (
          isAdmin()
          || (
            validBadges(request.resource.data.badges)
            && (
              request.resource.data.badges == resource.data.badges
              || badgeOverrideMatches(uid, request.resource.data.badges)
              || badgesCleared(request.resource.data.badges)
              || (
                exists(/databases/$(database)/documents/profiles/$(uid))
                && request.resource.data.badges
                    == get(/databases/$(database)/documents/profiles/$(uid)).data.badges
              )
            )
          )
        )
        && validPrivacy(request.resource.data.privacy)
        && validStats(request.resource.data.stats)
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 2
        && request.resource.data.ageGroup is string
        && request.resource.data.ageGroup.size() <= 12
        && request.resource.data.pendingDeletion is bool
        && (!('coverVersion' in request.resource.data)
            || (request.resource.data.coverVersion is int
                && request.resource.data.coverVersion >= 0))
        && (
          request.resource.data.username == resource.data.username
          || (
            validUsername(request.resource.data.username)
            && request.resource.data.normalizedUsername == request.resource.data.username.lower()
            && exists(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername))
            && get(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)).data.uid == uid
            // A regular account renames once every 48 hours; a verified or
            // developer account renames freely. Documents written before this
            // field existed are allowed their first change.
            && (
              isAdmin()
              || hasOfficialBadge(uid)
              || !('usernameChangedAt' in resource.data)
              || request.time
                  > resource.data.usernameChangedAt + duration.value(48, 'h')
            )
            && request.resource.data.usernameChangedAt is timestamp
          )
        );

      // Administrative state changes. The shape is fixed so a staff write can
      // never become an arbitrary profile edit, and the state itself is a
      // closed list.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(adminFields())
        && (!('accountStatus' in request.resource.data)
            || validAccountState(request.resource.data.accountStatus))
        && (!('statusReason' in request.resource.data)
            || (request.resource.data.statusReason is string
                && request.resource.data.statusReason.size() <= 500))
        && (!('restrictions' in request.resource.data)
            || validRestrictions(request.resource.data.restrictions))
        && (!('warningsCount' in request.resource.data)
            || (request.resource.data.warningsCount is int
                && request.resource.data.warningsCount >= 0));

      // The owner may rewrite the document wholesale (account purge and
      // tombstone). Lower roles cannot.
      allow write: if isOwner();

      allow delete: if isSelf(uid) || isAdmin();

      // Formal warnings. Readable by the account and by staff; only staff
      // writes them, and a warning is revoked rather than deleted so the
      // audit history survives.
      match /warnings/{warningId} {
        allow get, list: if isSelf(uid) || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 40
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 500
          && request.resource.data.active == true
          && request.resource.data.createdAt is timestamp;
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'active', 'revokedAt', 'revokedBy'
          ]);
        allow delete: if false;
      }

      // Administrative notifications. They are stored separately from community
      // replies so the account can always re-read an action it missed, and so
      // the reply stream is never polluted.
      match /adminNotices/{noticeId} {
        allow get, list: if isSelf(uid) || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 160
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 4000
          && request.resource.data.category in [
            'account-status', 'warning', 'restriction', 'message',
            'deletion', 'info'
          ]
          && request.resource.data.severity in ['info', 'warning', 'critical']
          && request.resource.data.read == false
          && request.resource.data.createdAt is timestamp;
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if isSelf(uid);
      }

      // Owned subcollections. Deletes are always allowed for the owner: a rule
      // that inspects request.resource.data would otherwise reject them,
      // because a delete carries no resource payload.
      match /library/{animeId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validLibraryEntry(request.resource.data);
        allow delete: if isSelf(uid);
      }

      match /history/{episodeKey} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validHistoryEntry(request.resource.data);
        allow delete: if isSelf(uid);
      }

      match /settings/account {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.localeCode is string
          && request.resource.data.localeCode.size() <= 5
          && request.resource.data.autoplayNext is bool
          && request.resource.data.rememberPosition is bool
          && request.resource.data.playbackSpeed is number
          && request.resource.data.playbackSpeed >= 0.25
          && request.resource.data.playbackSpeed <= 3.0
          && request.resource.data.preferredQuality is string
          && request.resource.data.preferredQuality.size() <= 8;
        allow delete: if isSelf(uid);
      }

      match /meta/{docId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validStats(request.resource.data);
        allow delete: if isSelf(uid);
      }

      match /activity/{activityId} {
        allow read, write: if isSelf(uid);
      }

      // Episodes bookmarked into «حلقاتي». They carry display information only
      // — never a download path, a stream URL or playback progress.
      match /episodes/{episodeKey} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.animeId is string
          && request.resource.data.animeId.size() <= 200
          && request.resource.data.episodeId is string
          && request.resource.data.episodeId.size() <= 200
          && request.resource.data.animeTitle is string
          && request.resource.data.animeTitle.size() <= 200
          && request.resource.data.episodeNumber is int
          && request.resource.data.episodeNumber >= 0
          && request.resource.data.savedAt is timestamp
          && (!('episodeTitle' in request.resource.data)
              || request.resource.data.episodeTitle is string)
          && (!('posterUrl' in request.resource.data)
              || request.resource.data.posterUrl is string)
          && (!('contentPath' in request.resource.data)
              || request.resource.data.contentPath is string);
        allow delete: if isSelf(uid);
      }

      // Recent searches: one tiny document kept in step across devices.
      match /search/{docId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 20
          && (!('updatedAt' in request.resource.data)
              || request.resource.data.updatedAt is timestamp);
        allow delete: if isSelf(uid);
      }

      // Community alerts: a reply notification is written by the device that
      // posted the reply, straight into the parent author's list. The shape is
      // fixed so nobody can use it as a free-form mailbox, and only the owner
      // can read, mark read or remove an entry.
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow create: if signedIn()
          && request.auth.uid != uid
          && request.resource.data.toUid == uid
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.type == 'reply'
          && request.resource.data.read == false
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && request.resource.data.episodeId is string
          && request.resource.data.commentId is string
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 40
          && request.resource.data.actorUsername is string
          && validUsername(request.resource.data.actorUsername)
          && request.resource.data.createdAt is timestamp;
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if isSelf(uid);
      }

      // Avatar bytes: readable by signed-in users so profile pictures render on
      // public profiles, writable only by the owner and capped below 1 MiB.
      // Create/update are separate from delete, because a delete request has no
      // `request.resource` payload and would otherwise always be rejected.
      match /private/avatar {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && request.resource.data.byteSize is int
          && request.resource.data.byteSize <= 204800
          && request.resource.data.bytes is bytes;
        allow delete: if isSelf(uid);
      }

      // Cover banner bytes: same contract as the avatar, with a wider budget
      // because a 16:10 banner needs more pixels.
      match /private/cover {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && request.resource.data.byteSize is int
          && request.resource.data.byteSize <= 500000
          && request.resource.data.bytes is bytes;
        allow delete: if isSelf(uid);
      }

      match /private/{docId} {
        allow read, write: if isSelf(uid)
          && docId != 'avatar'
          && docId != 'cover';
      }
    }

    // ---------------------------------------------------------- profiles
    // Public mirror: contains only the fields the owner chose to share.
    // Create and update are separate so a fresh document never has to compare
    // against a `resource` that does not exist yet.
    match /profiles/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && validPublic(request.resource.data)
        && request.resource.data.badges.verified == false
        && request.resource.data.badges.developer == false;

      allow update: if isSelf(uid)
        && validPublic(request.resource.data)
        && (
          isAdmin()
          || request.resource.data.badges == resource.data.badges
          || badgeOverrideMatches(uid, request.resource.data.badges)
          || badgesCleared(request.resource.data.badges)
          // The mirror may copy the badges the owner document already holds,
          // which is how a grant made only in the console reaches the mirror.
          || (
            exists(/databases/$(database)/documents/users/$(uid))
            && ('badges' in get(/databases/$(database)/documents/users/$(uid)).data)
            && request.resource.data.badges
                == get(/databases/$(database)/documents/users/$(uid)).data.badges
          )
        );

      allow delete: if isSelf(uid) || isAdmin();
    }

    // --------------------------------------------------------- usernames
    // Exact document lookups only: listing is forbidden so the registry cannot
    // be enumerated.
    //
    // Reads are allowed before sign-in on purpose: the registration form asks
    // for the handle on its first step, when no account exists yet. The only
    // thing revealed is whether one specific guessed handle is taken, which the
    // public profile mirror already shows for every existing user.
    match /usernames/{normalized} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && !accountBlocked(request.auth.uid)
        && !exists(/databases/$(database)/documents/usernameBlocks/$(normalized))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == normalized
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isOwner());
    }

    // --------------------------------------------------- blocked usernames
    // A blocked handle cannot be reserved by anyone, including the account that
    // used to own it. The registry stays an exact-lookup collection so it can
    // never be enumerated; staff can list it.
    match /usernameBlocks/{normalized} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isOwner()
        && (!('username' in request.resource.data)
            || request.resource.data.username == normalized);
    }

    // ------------------------------------------------------ blocked emails
    // Documents are keyed by the SHA-256 of the normalized address, so no raw
    // address is stored. Only staff can read the list; registration asks the
    // rules through `emailChecks` instead of reading it.
    match /emailBlocks/{hash} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isOwner();
    }

    // Registration probe: creating the throw-away marker is only allowed while
    // the address is **not** blocked. A denied write is the "blocked" answer.
    match /emailChecks/{hash} {
      allow create: if request.resource.data.hash == hash
        && !exists(/databases/$(database)/documents/emailBlocks/$(hash));
      allow delete: if resource.data.hash == hash;
      allow read, update: if false;
    }

    // --------------------------------------------------------- catalogue
    // Episode documents are managed outside the app; clients only read.
    //
    // View counters live in `episodes/{id}/stats/views` (and
    // `anime/{id}/stats/views`) so a popular episode never needs a write to its
    // catalogue document. Clients may only create the counter at 1 or add
    // exactly one, which keeps a tampered client from writing any number.
    match /episodes/{episodeId} {
      allow read: if signedIn();
      allow write: if false;

      // Legacy self-incrementing counter: frozen. It is no longer read by the
      // app because the number could be inflated without a real viewer.
      match /stats/views {
        allow read, write: if false;
      }

      // Real views: one document per account that watched the episode. The
      // displayed number is a count() over these documents, so nobody can
      // raise it twice or write an arbitrary value.
      match /stats/watch {
        allow read: if signedIn();
        match /viewers/{viewerId} {
          allow get, list: if signedIn();
          allow create: if signedIn() && viewerId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && canAct(uid, 'interact')
          && request.resource.data.uid == uid
          && request.resource.data.episodeId == episodeId
          && request.resource.data.type in ['like', 'dislike'];
        allow delete: if isSelf(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && canAct(request.auth.uid, 'comment')
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.episodeId == episodeId
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.deleted == false
          && request.resource.data.replyCount == 0
          && validDisplayName(request.resource.data.authorName)
          && validUsername(request.resource.data.authorUsername)
          && validBadges(request.resource.data.authorBadges)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        allow update: if signedIn()
          && (
            // The author may edit text or their own display snapshot.
            (
              resource.data.authorUid == request.auth.uid
              && request.resource.data.authorUid == resource.data.authorUid
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 1000
              && request.resource.data.deleted is bool
              && request.resource.data.replyCount == resource.data.replyCount
            )
            ||
            // Keeping an author's comments in step with a rename, a new badge
            // or a new profile picture.
            (
              resource.data.authorUid == request.auth.uid
              && request.resource.data.authorUid == resource.data.authorUid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'authorUsername', 'authorName', 'authorBadges', 'photoVersion', 'updatedAt'
              ])
              && validUsername(request.resource.data.authorUsername)
              && validDisplayName(request.resource.data.authorName)
              && validBadges(request.resource.data.authorBadges)
              && request.resource.data.photoVersion is int
              && request.resource.data.updatedAt is timestamp
            )
            ||
            // Replies raise or lower the counter by exactly one, never below
            // zero, so deleting a reply keeps the thread consistent.
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
              && (
                request.resource.data.replyCount == resource.data.replyCount + 1
                || (
                  resource.data.replyCount > 0
                  && request.resource.data.replyCount == resource.data.replyCount - 1
                )
              )
            )
          );

        // The author may remove their own comment; the owner may remove any
        // comment as part of moderation or an account purge.
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid || isOwner());

        match /replies/{replyId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && canAct(request.auth.uid, 'comment')
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.parentId == commentId
            && request.resource.data.episodeId == episodeId
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000
            && request.resource.data.deleted == false
            && validDisplayName(request.resource.data.authorName)
            && validUsername(request.resource.data.authorUsername)
            && validBadges(request.resource.data.authorBadges)
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;
          allow update: if signedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid;
          // A reply disappears with its thread: either its own author or the
          // author of the parent comment may delete it. The parent lookup is
          // guarded because the parent is usually deleted first when an account
          // is removed, and `get()` on a missing document makes the whole
          // deletion request fail instead of returning false.
          allow delete: if signedIn()
            && (
              isOwner()
              || resource.data.authorUid == request.auth.uid
              || (
                exists(/databases/$(database)/documents/episodes/$(episodeId)/comments/$(commentId))
                && get(/databases/$(database)/documents/episodes/$(episodeId)/comments/$(commentId)).data.authorUid == request.auth.uid
              )
            );
        }
      }
    }

    // ------------------------------------------------ title view counters
    // One counter per title, shown on the details screen. Same constraint as
    // episode views: create at 1 or increment by exactly one.
    match /anime/{animeId}/stats/views {
      allow read, write: if false;
    }

    match /anime/{animeId}/stats/watch {
      allow read: if signedIn();
      match /viewers/{viewerId} {
        allow get, list: if signedIn();
        allow create: if signedIn() && viewerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------ badges
    // Administrator-granted official marks. Readable by every signed-in user
    // so a handle shows its gold seal or blue developer mark everywhere, and
    // writable only by an administrator (the console bypasses these rules).
    //
    // Shape: `{verified: bool, developer: bool}`.
    match /badges/{uid} {
      allow get, list: if signedIn();
      allow write: if isAdmin();
      // An account that deletes itself takes its own record with it; nobody
      // else can remove a mark, and no owner can grant one.
      allow delete: if isSelf(uid);
    }

    // ----------------------------------------------------------- reports
    match /reports/{reportId} {
      allow create: if signedIn()
        && canAct(request.auth.uid, 'report')
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200
        && (!('targetUid' in request.resource.data)
            || request.resource.data.targetUid is string);
      allow read, delete: if isAdmin();
      // Review only moves the report between the closed states and records who
      // decided and why; the reporter's original text is immutable.
      allow update: if isAdmin()
        && request.resource.data.status in ['open', 'reviewed', 'resolved', 'dismissed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewNote', 'reviewedBy', 'updatedAt'
        ]);
    }

    // ------------------------------------------------- administrative audit
    // Append-only by staff, readable by staff only. A moderator's or admin's
    // action is recorded next to the owner's so responsibility is clear.
    match /adminActions/{actionId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 40
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() <= 200
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // ------------------------------------------- personal owner messages
    // One thread per recipient. The owner writes, the recipient reads and may
    // mark a message read or remove it from their own mailbox.
    match /ownerMessages/{uid}/items/{messageId} {
      allow get, list: if isSelf(uid) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 4000
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if isSelf(uid);
    }

    match /ownerMessages/{uid} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------ config
    // Read by rules through get()/exists(), which bypass this match. Clients
    // can never read or write it, so the admin allowlist stays private.
    match /config/{docId} {
      // Staff may read the allowlist so the app can resolve its role. Nobody can
      // read it before being staff, and only the console can write it.
      allow get: if docId == 'admins' && isAdmin();
      allow read, write: if false;
    }

    // Anything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
