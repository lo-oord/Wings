rules_version = '2';

// Wings — deny-by-default rules.
//
// Ownership always comes from request.auth.uid, never from a client field.
// Private profile data lives in owner-only documents; only the privacy-filtered
// `profiles/{uid}` mirror is readable by other users.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Administrative allowlist. Only the console/service account can write it.
    function adminUids() {
      return get(/databases/$(database)/documents/config/admins).data.uids;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in adminUids();
    }

    function validUsername(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 20
        && value.matches('^[A-Za-z0-9_]+$');
    }

    function validDisplayName(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    function validBadges(value) {
      return value is map
        && value.keys().hasOnly(['verified', 'developer'])
        && value.verified is bool
        && value.developer is bool;
    }

    function validPrivacy(value) {
      return value is map
        && value.keys().hasOnly([
          'showProfile', 'bio', 'country', 'age', 'favorites', 'stats'
        ])
        && value.showProfile is bool
        && value.bio is bool
        && value.country is bool
        && value.age is bool
        && value.favorites is bool
        && value.stats is bool;
    }

    // `updatedAt` is the only extra key allowed next to the counters, because
    // profile creation writes it into `users/{uid}/meta/stats`.
    function validStats(value) {
      return value is map
        && value.keys().hasOnly([
          'animeWatched', 'episodesWatched', 'favorites', 'completed', 'updatedAt'
        ])
        && value.animeWatched is int && value.animeWatched >= 0
        && value.episodesWatched is int && value.episodesWatched >= 0
        && value.favorites is int && value.favorites >= 0
        && value.completed is int && value.completed >= 0
        && (!('updatedAt' in value) || value.updatedAt is timestamp);
    }

    // Public favourites: a short, display-only snapshot of the owner's list.
    // Rules cannot iterate a list, so the shape is bounded by size only; the
    // values are written by the owner and never trusted as counters.
    function validFavorites(value) {
      return value is list && value.size() <= 12;
    }

    // Shared validation for the public mirror document.
    function validPublic(value) {
      return value.username is string
        && validUsername(value.username)
        && validDisplayName(value.displayName)
        && validBadges(value.badges)
        && (!('bio' in value) || (value.bio is string && value.bio.size() <= 300))
        && (!('country' in value) || (value.country is string && value.country.size() <= 2))
        && (!('ageGroup' in value) || (value.ageGroup is string && value.ageGroup.size() <= 12))
        && (!('stats' in value) || validStats(value.stats))
        && (!('favorites' in value) || validFavorites(value.favorites))
        && (!('coverVersion' in value)
            || (value.coverVersion is int && value.coverVersion >= 0))
        && (!('private' in value) || value.private is bool);
    }

    function validLibraryEntry(value) {
      return value.updatedAt is timestamp
        && value.isFavorite is bool
        && value.status in ['watching', 'completed', 'planToWatch', 'onHold', 'dropped'];
    }

    function validHistoryEntry(value) {
      return value.updatedAt is timestamp
        && value.positionMs is int && value.positionMs >= 0
        && value.durationMs is int && value.durationMs >= 0
        && value.completed is bool;
    }

    // ------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.username is string
        && validUsername(request.resource.data.username)
        && request.resource.data.normalizedUsername == request.resource.data.username.lower()
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 2
        && request.resource.data.ageGroup is string
        && request.resource.data.ageGroup.size() <= 12
        && validPrivacy(request.resource.data.privacy)
        && validStats(request.resource.data.stats)
        && validBadges(request.resource.data.badges)
        && request.resource.data.badges.verified == false
        && request.resource.data.badges.developer == false
        && (!('photoVersion' in request.resource.data)
            || (request.resource.data.photoVersion is int
                && request.resource.data.photoVersion >= 0))
        && (!('coverVersion' in request.resource.data)
            || (request.resource.data.coverVersion is int
                && request.resource.data.coverVersion >= 0))
        && (!('pendingDeletion' in request.resource.data)
            || request.resource.data.pendingDeletion is bool);

      // Owners may edit their own profile but never grant themselves badges.
      // They may only copy the badges an administrator already published on
      // the public mirror, which is what lets a verified account update its
      // bio without the write being rejected. A rename is only accepted when
      // the matching reservation belongs to them.
      allow update: if isSelf(uid)
        && (
          isAdmin()
          || (
            validBadges(request.resource.data.badges)
            && (
              request.resource.data.badges == resource.data.badges
              || (
                exists(/databases/$(database)/documents/profiles/$(uid))
                && request.resource.data.badges
                    == get(/databases/$(database)/documents/profiles/$(uid)).data.badges
              )
            )
          )
        )
        && validPrivacy(request.resource.data.privacy)
        && validStats(request.resource.data.stats)
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 2
        && request.resource.data.ageGroup is string
        && request.resource.data.ageGroup.size() <= 12
        && request.resource.data.pendingDeletion is bool
        && (!('coverVersion' in request.resource.data)
            || (request.resource.data.coverVersion is int
                && request.resource.data.coverVersion >= 0))
        && (
          request.resource.data.username == resource.data.username
          || (
            validUsername(request.resource.data.username)
            && request.resource.data.normalizedUsername == request.resource.data.username.lower()
            && exists(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername))
            && get(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)).data.uid == uid
          )
        );

      allow delete: if isSelf(uid) || isAdmin();

      // Owned subcollections. Deletes are always allowed for the owner: a rule
      // that inspects request.resource.data would otherwise reject them,
      // because a delete carries no resource payload.
      match /library/{animeId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validLibraryEntry(request.resource.data);
        allow delete: if isSelf(uid);
      }

      match /history/{episodeKey} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validHistoryEntry(request.resource.data);
        allow delete: if isSelf(uid);
      }

      match /settings/account {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.localeCode is string
          && request.resource.data.localeCode.size() <= 5
          && request.resource.data.autoplayNext is bool
          && request.resource.data.rememberPosition is bool
          && request.resource.data.playbackSpeed is number
          && request.resource.data.playbackSpeed >= 0.25
          && request.resource.data.playbackSpeed <= 3.0
          && request.resource.data.preferredQuality is string
          && request.resource.data.preferredQuality.size() <= 8;
        allow delete: if isSelf(uid);
      }

      match /meta/{docId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validStats(request.resource.data);
        allow delete: if isSelf(uid);
      }

      match /activity/{activityId} {
        allow read, write: if isSelf(uid);
      }

      // Avatar bytes: readable by signed-in users so profile pictures render on
      // public profiles, writable only by the owner and capped below 1 MiB.
      // Create/update are separate from delete, because a delete request has no
      // `request.resource` payload and would otherwise always be rejected.
      match /private/avatar {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && request.resource.data.byteSize is int
          && request.resource.data.byteSize <= 204800
          && request.resource.data.bytes is bytes;
        allow delete: if isSelf(uid);
      }

      // Cover banner bytes: same contract as the avatar, with a wider budget
      // because a 16:10 banner needs more pixels.
      match /private/cover {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && request.resource.data.byteSize is int
          && request.resource.data.byteSize <= 500000
          && request.resource.data.bytes is bytes;
        allow delete: if isSelf(uid);
      }

      match /private/{docId} {
        allow read, write: if isSelf(uid)
          && docId != 'avatar'
          && docId != 'cover';
      }
    }

    // ---------------------------------------------------------- profiles
    // Public mirror: contains only the fields the owner chose to share.
    // Create and update are separate so a fresh document never has to compare
    // against a `resource` that does not exist yet.
    match /profiles/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && validPublic(request.resource.data)
        && request.resource.data.badges.verified == false
        && request.resource.data.badges.developer == false;

      allow update: if isSelf(uid)
        && validPublic(request.resource.data)
        && (
          isAdmin()
          || request.resource.data.badges == resource.data.badges
        );

      allow delete: if isSelf(uid) || isAdmin();
    }

    // --------------------------------------------------------- usernames
    // Exact document lookups only: listing is forbidden so the registry cannot
    // be enumerated.
    //
    // Reads are allowed before sign-in on purpose: the registration form asks
    // for the handle on its first step, when no account exists yet. The only
    // thing revealed is whether one specific guessed handle is taken, which the
    // public profile mirror already shows for every existing user.
    match /usernames/{normalized} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == normalized
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --------------------------------------------------------- catalogue
    // Episode documents are managed outside the app; clients only read.
    //
    // View counters live in `episodes/{id}/stats/views` (and
    // `anime/{id}/stats/views`) so a popular episode never needs a write to its
    // catalogue document. Clients may only create the counter at 1 or add
    // exactly one, which keeps a tampered client from writing any number.
    match /episodes/{episodeId} {
      allow read: if signedIn();
      allow write: if false;

      // Legacy self-incrementing counter: frozen. It is no longer read by the
      // app because the number could be inflated without a real viewer.
      match /stats/views {
        allow read, write: if false;
      }

      // Real views: one document per account that watched the episode. The
      // displayed number is a count() over these documents, so nobody can
      // raise it twice or write an arbitrary value.
      match /stats/watch {
        allow read: if signedIn();
        match /viewers/{viewerId} {
          allow get, list: if signedIn();
          allow create: if signedIn() && viewerId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.episodeId == episodeId
          && request.resource.data.type in ['like', 'dislike'];
        allow delete: if isSelf(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.episodeId == episodeId
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.deleted == false
          && request.resource.data.replyCount == 0
          && validDisplayName(request.resource.data.authorName)
          && validUsername(request.resource.data.authorUsername)
          && validBadges(request.resource.data.authorBadges)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        allow update: if signedIn()
          && (
            // The author may edit text or their own display snapshot.
            (
              resource.data.authorUid == request.auth.uid
              && request.resource.data.authorUid == resource.data.authorUid
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 1000
              && request.resource.data.deleted is bool
              && request.resource.data.replyCount == resource.data.replyCount
            )
            ||
            // Keeping an author's comments in step with a rename, a new badge
            // or a new profile picture.
            (
              resource.data.authorUid == request.auth.uid
              && request.resource.data.authorUid == resource.data.authorUid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'authorUsername', 'authorName', 'authorBadges', 'photoVersion', 'updatedAt'
              ])
              && validUsername(request.resource.data.authorUsername)
              && validDisplayName(request.resource.data.authorName)
              && validBadges(request.resource.data.authorBadges)
              && request.resource.data.photoVersion is int
              && request.resource.data.updatedAt is timestamp
            )
            ||
            // Replies raise or lower the counter by exactly one, never below
            // zero, so deleting a reply keeps the thread consistent.
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
              && (
                request.resource.data.replyCount == resource.data.replyCount + 1
                || (
                  resource.data.replyCount > 0
                  && request.resource.data.replyCount == resource.data.replyCount - 1
                )
              )
            )
          );

        allow delete: if signedIn()
          && resource.data.authorUid == request.auth.uid;

        match /replies/{replyId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.parentId == commentId
            && request.resource.data.episodeId == episodeId
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000
            && request.resource.data.deleted == false
            && validDisplayName(request.resource.data.authorName)
            && validUsername(request.resource.data.authorUsername)
            && validBadges(request.resource.data.authorBadges)
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;
          allow update: if signedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid;
          // A reply disappears with its thread: either its own author or the
          // author of the parent comment may delete it.
          allow delete: if signedIn()
            && (
              resource.data.authorUid == request.auth.uid
              || get(/databases/$(database)/documents/episodes/$(episodeId)/comments/$(commentId)).data.authorUid == request.auth.uid
            );
        }
      }
    }

    // ------------------------------------------------ title view counters
    // One counter per title, shown on the details screen. Same constraint as
    // episode views: create at 1 or increment by exactly one.
    match /anime/{animeId}/stats/views {
      allow read, write: if false;
    }

    match /anime/{animeId}/stats/watch {
      allow read: if signedIn();
      match /viewers/{viewerId} {
        allow get, list: if signedIn();
        allow create: if signedIn() && viewerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ----------------------------------------------------------- reports
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------ config
    // Read by rules through get()/exists(), which bypass this match. Clients
    // can never read or write it, so the admin allowlist stays private.
    match /config/{docId} {
      allow read, write: if false;
    }

    // Anything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
